# Copy with scripts/dev.ps1 setup; no real secrets in this file.
STOREOS_DB_HOST=127.0.0.1
STOREOS_DB_PORT=5432
STOREOS_DB_NAME=storeos
STOREOS_DB_USER=storeos
STOREOS_DB_PASSWORD_FILE=.local/secrets/db_password.txt
STOREOS_DB_MIGRATION_USER=storeos_owner
STOREOS_DB_MIGRATION_PASSWORD_FILE=.local/secrets/db_owner_password.txt
STOREOS_HOST=127.0.0.1
STOREOS_PORT=8080
# setup replaces these placeholders with stable random UUIDs, not domain records.
STOREOS_COMPANY_ID=SETUP_GENERATES_UUID
STOREOS_LOCATION_ID=SETUP_GENERATES_UUID
STOREOS_ALLOWED_ORIGINS=http://127.0.0.1:8085,http://localhost:8085
STOREOS_SESSION_TTL_SECONDS=3600
STOREOS_BOOTSTRAP_USERNAME=operator
STOREOS_BOOTSTRAP_PASSWORD_FILE=.local/secrets/bootstrap_password.txt
