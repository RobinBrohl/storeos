{
  "$schema": "https://opencode.ai/config.json",

  // Dart is natively supported by OpenCode's LSP integration.
  "lsp": true,

  // Dart is currently not listed among OpenCode's built-in formatters,
  // therefore configure it explicitly.
  "formatter": {
    "dart": {
      "command": ["dart", "format", "$FILE"],
      "extensions": [".dart"]
    }
  },

  // Preserve tool output for correctness during long engineering sessions.
  "compaction": {
    "auto": true,
    "prune": false
  },

  // Avoid noisy generated directories.
  "watcher": {
    "ignore": [
      ".git/**",
      ".dart_tool/**",
      "build/**",
      "coverage/**",
      "**/.gradle/**",
      "**/node_modules/**",
      "**/.idea/**"
    ]
  },

  "permission": {
    // Repository files are readable, except secrets.
    "read": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",

      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.env.example": "allow",

      "**/secrets/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },

    // Code may be edited normally, but secrets must never be modified.
    "edit": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",

      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.env.example": "allow",

      "**/secrets/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },

    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",

    // Current external documentation and research.
    "webfetch": "allow",
    "websearch": "allow",

    // Anything outside the StoreOS worktree requires approval.
    "external_directory": "ask",

    // Stop and ask if the agent repeats the identical tool call.
    "doom_loop": "ask",

    // Routine inspection/test commands can run without interruption.
    // Everything else requires approval.
    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git grep*": "allow",
      "git rev-parse*": "allow",
      "git branch --show-current*": "allow",

      "dart analyze*": "allow",
      "dart test*": "allow",

      "flutter analyze*": "allow",
      "flutter test*": "allow",

      "docker compose ps*": "allow",
      "docker compose logs*": "allow",
      "docker compose config*": "allow",

      // Dependency resolution can modify lockfiles.
      "dart pub get*": "ask",
      "flutter pub get*": "ask",

      // Whole-repository formatting can create large diffs.
      // Individual edited Dart files are formatted automatically above.
      "dart format*": "ask",

      // Keep repository history human-controlled.
      "git commit*": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny"
    },

    // Dart MCP: default to asking, then explicitly allow safe/read-only tools.
    "dart_*": "ask",
    "dart_analyze_files": "allow",
    "dart_lsp": "allow",
    "dart_pub_dev_search": "allow",
    "dart_read_package_uris": "allow",
    "dart_rip_grep_packages": "allow",
    "dart_roots": "allow",
    "dart_widget_inspector": "allow",

    // Dependency-changing Dart MCP operations require approval.
    "dart_pub": "ask",
    "dart_vm_service": "ask",
    "dart_dtd": "ask",

    // Documentation lookup is safe.
    "context7_*": "allow",

    // Browser automation can perform real actions.
    "playwright_*": "ask",

    // Optional official Google documentation MCP.
    "google-developer-knowledge_*": "allow"
  },

  "mcp": {
    "dart": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server"
      ]
    },

    // Enable only when performing browser/E2E work.
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false,
      "timeout": 10000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": {}
    }
  }
}